# ClinSaarthi AI - Environment Configuration Example
# Copy this file to .env and fill in values as appropriate for your environment.

# Django Security
DJANGO_SECRET_KEY=
DEBUG=
ENVIRONMENT=
ALLOWED_HOSTS=

# Database Connection (PostgreSQL for staging/production, SQLite fallback for local dev)
# Example PostgreSQL: postgres://postgres:postgres@localhost:5432/clinsaarthi
# Example SQLite: sqlite:///db.sqlite3
DATABASE_URL=

# JWT Authentication
JWT_SECRET=
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=
JWT_REFRESH_TOKEN_LIFETIME_DAYS=

# Hugging Face Inference API Token (Fine-grained inference-only token)
# FREE from https://huggingface.co/settings/tokens
HF_TOKEN=

# Model Configurations (Swappable without code changes)
LLM_MODEL_ID=
EMBEDDING_MODEL_ID=
RERANKER_MODEL_ID=
NLI_MODEL_ID=
SPACY_MODEL=

# Vector Database Configuration
VECTOR_STORE_PROVIDER=
CHROMA_PERSIST_DIRECTORY=

# RAG & Debug Flags
DEBUG_RAG=
CONFIDENCE_THRESHOLD=

# Note on External Medical Reference APIs:
# RxNorm (NIH/NLM) and openFDA are public, free US Government medical reference APIs.
# They require NO API keys, registration, or credit card.
# RxNorm base: https://rxnav.nlm.nih.gov/REST/
# openFDA base: https://api.fda.gov/drug/label.json
