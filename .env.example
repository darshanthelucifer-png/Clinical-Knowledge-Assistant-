# ==============================================================================
# ClinSaarthi AI - Root Docker & Local Environment Variables
# Copy this file to .env before starting the services
# ==============================================================================

# Environment Mode ('dev', 'prod', or 'staging')
ENVIRONMENT=dev
DEBUG=True

# Django Core Security
DJANGO_SECRET_KEY=django-insecure-clinsaarthi-dev-change-in-production-2026
ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend

# Database URL
# SQLite default: sqlite:///db.sqlite3
# PostgreSQL Docker Compose default: postgres://postgres:postgrespassword@db:5432/clinsaarthi
DATABASE_URL=postgres://postgres:postgrespassword@db:5432/clinsaarthi

# SimpleJWT Authentication
JWT_SECRET=jwt-clinsaarthi-super-secret-key-2026
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Vector Store Engine ('chroma' or 'faiss')
VECTOR_STORE_PROVIDER=chroma
CHROMA_PERSIST_DIRECTORY=./data/chroma_db

# RAG & Verification Hyperparameters
CONFIDENCE_THRESHOLD=0.50
DEBUG_RAG=False

# Optional: Hugging Face API Token (Free from https://huggingface.co/settings/tokens)
# Leave empty to use local pipelines or mock/fallback inference
HF_TOKEN=

# Swappable Model Identifiers
LLM_MODEL_ID=Qwen/Qwen2.5-7B-Instruct
EMBEDDING_MODEL_ID=BAAI/bge-m3
RERANKER_MODEL_ID=BAAI/bge-reranker-base
NLI_MODEL_ID=MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli
SPACY_MODEL=en_core_sci_md
